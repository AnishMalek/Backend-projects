<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Todo Dashboard</title>


<style>
    *{
        margin:0;
        padding:0;
        box-sizing:border-box;
        font-family:'Segoe UI',sans-serif;
    }

    body{
        background:#f4f7fc;
        min-height:100vh;
        padding:40px;
    }

    .container{
        max-width:1100px;
        margin:auto;
    }

    .header{
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin-bottom:30px;
    }

    .header h1{
        color:#1f2937;
        font-size:32px;
    }

    .add-btn{
        text-decoration:none;
        background:#4f46e5;
        color:white;
        padding:12px 22px;
        border-radius:12px;
        font-weight:600;
        transition:.3s;
    }

    .add-btn:hover{
        transform:translateY(-2px);
        box-shadow:0 10px 20px rgba(79,70,229,.25);
    }

    .table-card{
        background:white;
        border-radius:20px;
        overflow:hidden;
        box-shadow:0 15px 40px rgba(0,0,0,.08);
    }

    table{
        width:100%;
        border-collapse:collapse;
    }

    thead{
        background:#4f46e5;
        color:white;
    }

    th{
        padding:18px;
        text-align:left;
    }

    td{
        padding:18px;
        border-bottom:1px solid #f1f1f1;
    }

    tr:hover{
        background:#fafbff;
    }

    .status{
        padding:8px 14px;
        border-radius:20px;
        font-size:14px;
        font-weight:600;
        display:inline-block;
    }

    .pending{
        background:#fff7ed;
        color:#ea580c;
    }

    .completed{
        background:#ecfdf5;
        color:#16a34a;
    }

    .action-btn{
        text-decoration:none;
        padding:8px 14px;
        border-radius:10px;
        font-size:14px;
        font-weight:600;
        margin-right:8px;
    }

    .edit{
        background:#dbeafe;
        color:#2563eb;
    }

    .delete{
        background:#fee2e2;
        color:#dc2626;
    }

    .empty{
        text-align:center;
        padding:30px;
        color:#888;
    }
</style>


</head>
<body>


<div class="container">

    <div class="header">
        <h1>📋 Todo Dashboard</h1>
        <a href="/add" class="add-btn">+ Add Task</a>
    </div>

    <div class="table-card">

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Task</th>
                    <th>Status</th>
                    <th colspan="2">Actions</th>
                </tr>
            </thead>

            <tbody>
                <% if(todoList.length === 0){ %>
                    <tr>
                        <td colspan="5" class="empty">
                            No tasks found
                        </td>
                    </tr>
                <% } %>

                <% todoList.forEach((p)=>{ %>
                    <tr>
                        <td><%= p.id %></td>

                        <td>
                            <strong><%= p.task %></strong>
                        </td>

                        <td>
                            <span class="status <%= p.status %>">
                                <%= p.status %>
                            </span>
                        </td>

                        <td>
                            <a
                                href="/edit/<%= p.id %>"
                                class="action-btn edit"
                            >
                                ✏️ Edit
                            </a>
                        </td>

                        <td>
                            <a
                                href="/delete/<%= p.id %>"
                                class="action-btn delete"
                            >
                                🗑 Delete
                            </a>
                        </td>
                    </tr>
                <% }) %>

            </tbody>
        </table>

    </div>

</div>


</body>
</html>

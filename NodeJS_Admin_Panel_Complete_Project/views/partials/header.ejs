<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || "Admin Panel" %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% if (admin) { %>
<nav class="navbar navbar-dark bg-dark mb-4">
  <div class="container">
    <a class="navbar-brand" href="/admin/dashboard">Admin Panel</a>
    <div>
      <a class="btn btn-sm btn-outline-light me-2" href="/admin/profile"><%= admin.name %></a>
      <a class="btn btn-sm btn-danger" href="/logout">Logout</a>
    </div>
  </div>
</nav>
<% } %>
<div class="container pb-5">
  <% if (success && success.length) { %>
    <% success.forEach(msg => { %><div class="alert alert-success"><%= msg %></div><% }) %>
  <% } %>
  <% if (error && error.length) { %>
    <% error.forEach(msg => { %><div class="alert alert-danger"><%= msg %></div><% }) %>
  <% } %>
  <% if (info && info.length) { %>
    <% info.forEach(msg => { %><div class="alert alert-info"><%= msg %></div><% }) %>
  <% } %>
  <% if (warning && warning.length) { %>
    <% warning.forEach(msg => { %><div class="alert alert-warning"><%= msg %></div><% }) %>
  <% } %>

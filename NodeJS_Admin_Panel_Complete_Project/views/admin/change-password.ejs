<%- include("../partials/header") %>
<div class="row justify-content-center"><div class="col-md-6">
<div class="card p-4 shadow-sm">
<h2>Change Password</h2>
<form method="POST" action="/admin/change-password">
<input class="form-control mb-3" type="password" name="oldPassword" placeholder="Old Password" required>
<input class="form-control mb-3" type="password" name="newPassword" placeholder="New Password" required>
<input class="form-control mb-3" type="password" name="confirmPassword" placeholder="Confirm New Password" required>
<button class="btn btn-primary">Change Password</button>
</form>
</div></div></div>
<%- include("../partials/footer") %>
<%- include("../../partials/header") %>
<div class="d-flex justify-content-between align-items-center"><h2>Categories</h2><a class="btn btn-primary" href="/admin/categories/add">Add Category</a></div>
<table class="table table-bordered mt-3"><thead><tr><th>Name</th><th>Description</th><th>Actions</th></tr></thead><tbody>
<% categories.forEach(c => { %>
<tr><td><%= c.name %></td><td><%= c.description %></td><td>
<a class="btn btn-sm btn-warning" href="/admin/categories/edit/<%= c._id %>">Edit</a>
<a class="btn btn-sm btn-danger" href="/admin/categories/delete/<%= c._id %>" onclick="return confirm('Delete category?')">Delete</a>
</td></tr>
<% }) %>
</tbody></table>
<%- include("../../partials/footer") %>
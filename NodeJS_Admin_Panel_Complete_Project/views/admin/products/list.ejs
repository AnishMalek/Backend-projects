<%- include("../../partials/header") %>
<div class="d-flex justify-content-between align-items-center"><h2>Products</h2><a class="btn btn-primary" href="/admin/products/add">Add Product</a></div>
<table class="table table-bordered table-responsive mt-3"><thead><tr><th>Product</th><th>Category</th><th>Subcategory</th><th>Price</th><th>Status</th><th>Actions</th></tr></thead><tbody>
<% products.forEach(p => { %>
<tr>
<td><%= p.name %></td>
<td><%= p.categoryId ? p.categoryId.name : "N/A" %></td>
<td><%= p.subcategoryId ? p.subcategoryId.name : "N/A" %></td>
<td>₹<%= p.price %></td>
<td><%= p.status %></td>
<td>
<a class="btn btn-sm btn-warning" href="/admin/products/edit/<%= p._id %>">Edit</a>
<a class="btn btn-sm btn-danger" href="/admin/products/delete/<%= p._id %>" onclick="return confirm('Delete product?')">Delete</a>
</td>
</tr>
<% }) %>
</tbody></table>
<%- include("../../partials/footer") %>
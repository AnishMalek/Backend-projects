<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Products - ShopEasy</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include("partials/navbar") %>

  <main class="container">
    <div class="header-section">
      <div>
        <h1>My Listed Products</h1>
        <p class="subtitle">Manage products created by you</p>
      </div>
      <a href="/products/new" class="btn btn-primary">+ Add New Product</a>
    </div>

    <% if (products.length === 0) { %>
      <div class="empty-state">
        <p>📦 You haven't added any products yet.</p>
        <a href="/products/new" class="btn btn-primary">Add Your First Product</a>
      </div>
    <% } else { %>
      <div class="product-grid">
        <% products.forEach(product => { %>
          <%- include("productItem", { product, showActions: true }) %>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>

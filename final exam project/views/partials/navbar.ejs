<nav class="navbar">
  <div class="nav-container">
    <a href="/products" class="nav-brand">
      <span class="brand-icon">🛍️</span> ShopEasy
    </a>
    <ul class="nav-links">
      <li><a href="/products">Products</a></li>
      <li><a href="/categories">Categories</a></li>

      <% if (typeof user !== 'undefined' && user) { %>
        <li><a href="/products/my">My Products</a></li>
        <li><a href="/products/new" class="btn-add">+ Add Product</a></li>
        <li class="user-info">
          <span class="user-name">👤 <%= user.username %></span>
          <% if (user.role === 'admin') { %>
            <span class="badge-admin">Admin</span>
          <% } %>
        </li>
        <li><a href="/logout" class="nav-logout">Logout</a></li>
      <% } else { %>
        <li><a href="/login">Login</a></li>
        <li><a href="/register" class="btn-register">Register</a></li>
      <% } %>
    </ul>
  </div>
</nav>

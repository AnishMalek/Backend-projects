<!DOCTYPE html>
<html>
<head>
    <title>Edit Blog</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <h1>Edit Blog</h1>

        <!-- Blog ID URL mathi automatically pass thay chhe -->
        <form action="/edit-blog/<%= blog._id %>" method="POST">
            <input
                type="text"
                name="title"
                value="<%= blog.title %>"
                required
            >

            <textarea name="description" required><%= blog.description %></textarea>

            <button type="submit">Update Blog</button>
        </form>

        <a href="/blogs">Back to Blogs</a>
    </div>
</body>
</html>

<%- include("../partials/header") %>

<h1>Edit Blog</h1>

<form action="/blogs/edit/<%= blog.id %>" method="POST">
    <div class="form-group">
        <label>Blog Title</label>
        <input type="text" name="title" value="<%= blog.title %>" required>
    </div>

    <div class="form-group">
        <label>Author</label>
        <input type="text" name="author" value="<%= blog.author %>" required>
    </div>

    <div class="form-group">
        <label>Category</label>
        <input type="text" name="category" value="<%= blog.category %>" required>
    </div>

    <div class="form-group">
        <label>Content</label>
        <textarea name="content" rows="8" required><%= blog.content %></textarea>
    </div>

    <button type="submit" class="btn">Update Blog</button>

    <a href="/blogs" class="cancel-btn">Cancel</a>
</form>

<%- include("../partials/footer") %>
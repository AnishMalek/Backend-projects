<%- include("../partials/header") %>

<div class="page-header">
    <h1>Blog List</h1>
    <a href="/blogs/add" class="btn">+ Add Blog</a>
</div>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Author</th>
            <th>Category</th>
            <th>Date</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        <% if (blogs.length === 0) { %>
            <tr>
                <td colspan="6" class="empty">No blogs available.</td>
            </tr>
        <% } %>

        <% blogs.forEach(blog => { %>
            <tr>
                <td><%= blog.id %></td>
                <td><%= blog.title %></td>
                <td><%= blog.author %></td>
                <td><%= blog.category %></td>
                <td><%= blog.createdAt %></td>
                <td>
                    <a href="/blogs/edit/<%= blog.id %>" class="edit-btn">Edit</a>

                    <a
                        href="/blogs/delete/<%= blog.id %>"
                        class="delete-btn"
                        onclick="return confirm('Are you sure you want to delete this blog?')"
                    >
                        Delete
                    </a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<%- include("../partials/footer") %>